# Upstox API Credentials
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:3000/callback
UPSTOX_ACCESS_TOKEN=your_access_token_here

# Trading Configuration
INITIAL_CAPITAL=100000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS_PERCENT=0.03
CIRCUIT_BREAKER_ENABLED=true

# Strategy Parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
EMA_PERIOD=200
ADX_PERIOD=14
ADX_TRENDING_THRESHOLD=25
ADX_RANGING_THRESHOLD=20
BB_PERIOD=20
BB_STD=2
ATR_PERIOD=14
ATR_MULTIPLIER_SL=3.0
ATR_MULTIPLIER_TSL=2.0

# Timeframe Configuration
PRIMARY_TIMEFRAME=1min
CONFIRMATION_TIMEFRAME=60min
CONFIRMATION_EMA_PERIOD=20

# Order Management
MAX_ORDER_SIZE=1000
TWAP_DURATION_MINUTES=30
VWAP_ENABLED=false

# Market Hours (IST)
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
PRE_MARKET_START=09:00

# Reconnection & Resilience
MAX_RETRY_ATTEMPTS=5
INITIAL_BACKOFF_SECONDS=1.0
MAX_BACKOFF_SECONDS=60.0
BACKOFF_MULTIPLIER=2.0

# WebSocket Configuration
WS_RECONNECT_DELAY=5
WS_HEARTBEAT_INTERVAL=30

# External Event Filter
TRADING_HALT_ON_EVENTS=true

# Logging
LOG_LEVEL=INFO

# Backtesting Configuration
BACKTEST_START_DATE=2008-01-01
BACKTEST_END_DATE=2024-01-01
